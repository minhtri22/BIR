{
  "name": "business-forensics-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1 --port 5173",
    "web:build": "tsc -p apps/web/tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test:e2e:headed": "node scripts/prepare-e2e.mjs && playwright test --headed"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.0.7",
    "typescript": "5.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  }
}
